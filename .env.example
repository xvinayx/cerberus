# Enables AI search (the "Describe what you need" bar). Without it, the bar is hidden.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Enables sign-in and saved ("hearted") properties. Without them, sign-in is hidden.
# Supabase dashboard -> Project Settings -> API Keys (or Data API) for both values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
